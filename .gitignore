__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Generated reports (the committed reports/sample_report.md is kept on purpose)
reports/*.md
!reports/sample_report.md
# ...and the committed live worked-example report is kept on purpose too.
!reports/live_carbon_routing_example.md
# Phase 1 telemetry output is a generated, append-only log, not source.
telemetry.csv

# Credentials / secrets — belt-and-suspenders for when a real AWS collector
# lands (see docs/architecture.md roadmap). Nothing here should ever exist
# in this repo, committed or not, but keep git from ever staging it by accident.
.env
.env.*
# ...but the committed template carries no secret and should be tracked.
!.env.example
*.pem
*.key
credentials
.aws/
secrets.json
*_rsa
*_ed25519
